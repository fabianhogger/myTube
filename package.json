{
  "name": "mytube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "filter": "tsx scripts/filter.ts",
    "verdicts": "tsx scripts/verdicts.ts",
    "yt:login": "tsx scripts/yt-login.ts",
    "oauth:login": "tsx scripts/oauth-login.ts",
    "fixtures": "tsx scripts/capture-fixtures.ts",
    "smoke": "rm -f data/test.db data/test.db-wal data/test.db-shm && MYTUBE_DB_PATH=data/test.db MYTUBE_OFFLINE=1 MYTUBE_FAKE_LLM=1 tsx scripts/ingest.ts && MYTUBE_DB_PATH=data/test.db MYTUBE_OFFLINE=1 MYTUBE_FAKE_LLM=1 tsx scripts/smoke-merge.ts && MYTUBE_DB_PATH=data/test.db MYTUBE_OFFLINE=1 MYTUBE_FAKE_LLM=1 tsx scripts/smoke-failsoft.ts && MYTUBE_DB_PATH=data/test.db MYTUBE_OFFLINE=1 MYTUBE_FAKE_LLM=1 tsx scripts/smoke-prompthash.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "googleapis": "^186.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
